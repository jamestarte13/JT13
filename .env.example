# ── Supabase ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Stripe ────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PERLETTER_PRICE_ID=price_...
STRIPE_ANNUAL_PRICE_ID=price_...
VITE_STRIPE_ANNUAL_PRICE_ID=price_...

# ── Mapbox ────────────────────────────────────────────────────
VITE_MAPBOX_TOKEN=pk.eyJ1...

# ── Resend ────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Admin Dashboard ───────────────────────────────────────────
# Also set as VITE_ADMIN_PASSWORD for client-side check
# For production, move auth server-side
VITE_ADMIN_PASSWORD=your-secure-password-here

# ── Developer Bypass ──────────────────────────────────────────
# Email that skips payment and goes straight to the result screen.
# Use your own email here to test the full post-letter flow.
VITE_DEV_EMAIL=you@yourdomain.com
